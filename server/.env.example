NODE_ENV=development
PORT=8080

MONGO_URI=mongodb://localhost:27017/

BCRYPT_SALT_ROUNDS=12

# Access token: short-lived. Refresh token: long-lived. Secrets must differ and be >= 32 chars.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Set true behind nginx / a load balancer so req.ip is the client IP.
TRUST_PROXY=false

COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional. If omitted, verification/reset links are logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AtomicTask <noreply@atomictask.local>
